# ClausePilot Environment Configuration

# Database: Default is SQLite for instant zero-dependency local demo
DATABASE_URL=sqlite:///./clausepilot.db
# To use PostgreSQL in production:
# DATABASE_URL=postgresql://clausepilot:clausepilot@localhost:5432/clausepilot_db

# LLM Provider Configuration (Optional)
# Supported: 'none' (default, uses rule-based + demo extractor), 'openai'
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo

# Upload directory for uploaded contract PDFs
UPLOAD_DIR=./uploads

# Server Port
PORT=8000
HOST=0.0.0.0
